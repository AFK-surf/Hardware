# Waveshare ESP32-S3-Touch-AMOLED-1.32: ESP32-S3-PICO-1, 8 MB flash, 8 MB octal PSRAM.
# CO5300 466x466 QSPI AMOLED, CST820 touch, ES8311 codec, PA on GPIO46, BOOT on GPIO0.
# Display and gateway, no voice: the board has a mic but no speaker (only a speaker header).
# Flash and PSRAM modes are the ones the reference project (voice-box-agent) ran on this board.
CONFIG_COMMA_BOARD_WAVESHARE_AMOLED_1_32=y
CONFIG_COMMA_HAS_VOICE=n
CONFIG_COMMA_HAS_DISPLAY=y
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# No ESP-SR model partition: factory app 0x10000-0x800000 (8 MB flash).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.waveshare-amoled-1-32.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The board's USB port is the S3's USB-Serial/JTAG, the secondary console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# As on the T-Circle (8 MB PSRAM): TLS records and NimBLE pools in PSRAM, so the Connector can start
# while BLE is up.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
