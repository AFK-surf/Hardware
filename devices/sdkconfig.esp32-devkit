# ESP32-D0WD rev v1.0, 240 MHz, 4 MB flash, no PSRAM; CH340 USB UART.
# Hardware identity measured with esptool flash-id (H1). BOOT is GPIO0.
CONFIG_IDF_TARGET="esp32"
CONFIG_COMMA_BOARD_ESP32_DEVKIT=y
CONFIG_COMMA_HAS_VOICE=n
CONFIG_COMMA_HAS_DISPLAY=n
CONFIG_COMMA_PAIRING_PASSKEY=n
CONFIG_COMMA_BOOT_GPIO=0
# GPIO2 blue LED confirmed by slow/fast blink on this DevKit.
CONFIG_COMMA_LED_GPIO=2
CONFIG_ESP32_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32-devkit.csv"
CONFIG_SPIRAM=n

# No-PSRAM memory settings modeled on Apache-2.0 muse-gadget-sdk's ideaspark
# and c6-nopsram overlays. Internal TLS allocation, 16 KiB inbound records
# (servers can send them) but only 4 KiB outbound.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# H1 hardware: with separate WebSocket RX/TX locks, dynamic RX buffer release
# clears in_ctr while the writer enters ssl_check_ctr_renegotiate (3 panics).
# Keep TLS buffers allocated and disable renegotiation to avoid that race.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
# BLE only: no classic Bluetooth controller; NimBLE must use internal RAM.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
# NimBLE SC_ONLY=1 also requires authenticated (MITM) GATT security, which
# Just Works cannot provide. SC stays enabled and LEGACY stays disabled:
# pairing still rejects peers without Secure Connections support.
CONFIG_BT_NIMBLE_SM_SC_ONLY=0
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
# Static Wi-Fi buffers cost 1.6 KiB each; BA windows at most twice their count.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
# H1: the inherited 64 KiB RX window left only ~44 KB internal RAM during
# 1 MiB chunks; TLS send-buffer allocation failed. 16 KiB windows passed 3/3.
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
# Keep hot paths in flash: classic ESP32 has less IRAM than S3.
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# H1 WSS measurements: 16 KiB text failed 3/3; 8 KiB text passed 3/3.
CONFIG_COMMA_LAN_HTTP_MAX_BYTES=8192
CONFIG_COMMA_LAN_HTTP_CHUNK_BYTES=4096
CONFIG_COMMA_LAN_HTTP_CHUNK_FRAME_BYTES=4096
CONFIG_COMMA_CONNECTOR_RX_MAX=16384
CONFIG_COMMA_LAN_DISCOVER_ARENA_BYTES=16384
# H2 BLE-up discovery ran out of memory with the 34,048-byte host table.
# 6/6 saves 20 KiB (13,568-byte table); overflow still sets truncated=true.
CONFIG_COMMA_LAN_DISCOVER_MAX_SERVICES=6
CONFIG_COMMA_LAN_DISCOVER_MAX_SSDP=6
# Discovery passed only 1/3 with a 48 KiB JSON budget. Retest this 12 KiB cap.
CONFIG_COMMA_LAN_DISCOVER_MAX_JSON=12288
CONFIG_COMMA_LAN_UDP_MAX_ANSWER=2048
CONFIG_COMMA_LAN_DISCOVER=y
# TLS leaves 36-49 KB largest blocks, insufficient for the server's 32 KiB
# raw tunnel frames (~43.7 KB base64 plus JSON). Backend must honor max_frame
# before DevKit tunnels can be reconsidered and retested.
CONFIG_COMMA_LAN_TUNNELS=0
CONFIG_COMMA_LAN_TUNNEL_WINDOW=32768
CONFIG_COMMA_LAN_TUNNEL_MAX_FRAME=4096
CONFIG_COMMA_CONNECTOR_WS_BUFFER_SIZE=2048
# Hardware measurements are complete; see the e6ced9c retest in the H1 report.
CONFIG_COMMA_HEAP_DIAGNOSTICS=n

# H2: bound probe state/payloads on no-PSRAM hardware. 4 KiB of answers is ~5.5 KiB
# of base64 within the unchanged 12 KiB result cap. Keep 1024-byte answers: a Gree
# scan envelope can approach 512 bytes, and the backend discards cut answers.
CONFIG_COMMA_LAN_DISCOVER_PROBES=4
CONFIG_COMMA_LAN_DISCOVER_PROBE_PAYLOAD=256
CONFIG_COMMA_LAN_DISCOVER_PROBE_ANSWER=1024
CONFIG_COMMA_LAN_DISCOVER_PROBE_BUDGET=4096
