# LilyGO T-Circle-S3: 16 MB DIO flash, 8 MB octal PSRAM.
CONFIG_COMMA_BOARD_T_CIRCLE_S3=y
CONFIG_IDF_TARGET="esp32s3"

# T-Circle-S3 module: 16 MB flash, 8 MB octal PSRAM.
# Flash stays DIO, the mode the logo firmware already boots with.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Cloudflare sends GTS Root R4 cross-signed by the retired GlobalSign Root CA.
# Cloudflare's 101 upgrade response is over 1 KB of headers.
# pcm16_24k is 48 KB/s each way. Without a proxy the RTT to Cloudflare is
# ~250 ms, so the 5760-byte default windows cap TCP near 23 KB/s (close 4410).
# The send buffer stays at 24 KB (0.5 s of audio, about 2x the bandwidth-delay
# product): a bigger one holds more stale audio that bursts out after a stall
# and trips the server's too_fast check (close 4400).
# Sends take their own lock. Otherwise every send waits while the websocket task reads a whole
# agent-audio frame (up to 16 KB) under the shared lock, often 300-500 ms, which drops mic audio
# and delays output.played into 4410.
# Agent audio stalls for 2-4 s on lossy Wi-Fi, which the server closes as 4410. SACK lets the
# server resend just the lost segment instead of waiting out a retransmission timeout, and a
# receive mailbox of 64 holds a full 64 KB window (32 x 1440 B is only 46 KB).
# lan_discover: a router answering SSDP ssdp:all sends a dozen or more datagrams at once, and
# mDNS answers arrive in bursts while the call tasks keep the discovery task waiting. The default
# mailbox of 6 drops the rest.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# BLE provisioning (provisioning.c). NimBLE, peripheral only, one connection, and only while
# unprovisioned or in pairing mode: BLE is fully shut down before a call can start.
# LE Secure Connections only, authenticated (passkey on the screen). Bonds stay in RAM: they
# only need to last one pairing session.
# The credentials JSON is a few hundred bytes; one write at the largest MTU fits it.
# GATT writes are parsed on the host task (a 513-byte buffer plus cJSON).
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Mic cleanup (voice_clean.c): ESP-SR AFE with neural noise suppression and VAD, models in the "model" partition.
# Lets voice_clean.lf put nsnet3's unused 19 KB .bss in PSRAM.
# CPU load per core in the call stats (idle tasks' run time).
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_NSN_NSNET2=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
