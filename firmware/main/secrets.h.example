#pragma once

// Dev override only. The firmware normally gets Wi-Fi and its credentials from the Comma app
// over BLE (provisioning.c) and keeps them in NVS. To skip that on a dev board, copy this file
// to secrets.h (gitignored) and set COMMA_DEV_SECRETS to 1: these values then replace NVS and the
// board never advertises unless pairing mode is entered (hold BOOT 3 s).
// COMMA_VOICE_KEY is a voice agent key (salix_vk_...). Do not log it or put it in sdkconfig.
// COMMA_CONNECTOR_URL is the connect_url returned with the connector token (the Salix host, not the
// Comma API host). COMMA_CONNECTOR_TOKEN is that token (salix_conn_...). Leave them unset to keep the
// Connector off.

#define COMMA_DEV_SECRETS 0

#define WIFI_SSID "changeme"
#define WIFI_PASSWORD "changeme"
#define COMMA_VOICE_SERVER "https://salix.comma.surf"  // production; use your own backend's voice host
#define COMMA_VOICE_GROUP "grp1_replace_me"
#define COMMA_VOICE_KEY "salix_vk_replace_me"
// Optional:
// #define COMMA_WORKSPACE_ID "..."
// #define COMMA_CONNECTOR_URL "wss://salix.comma.surf/v1/connect"
// #define COMMA_CONNECTOR_TOKEN "salix_conn_..."
